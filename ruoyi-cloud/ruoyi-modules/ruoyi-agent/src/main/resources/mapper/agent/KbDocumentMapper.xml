<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.agent.mapper.KbDocumentMapper">

    <resultMap type="com.ruoyi.agent.domain.KbDocument" id="KbDocumentResult">
        <id     property="id"              column="id"               />
        <result property="title"           column="title"            />
        <result property="fileName"        column="file_name"        />
        <result property="fileType"        column="file_type"        />
        <result property="fileUrl"         column="file_url"         />
        <result property="contentHash"     column="content_hash"     />
        <result property="parseStatus"     column="parse_status"     />
        <result property="embeddingStatus" column="embedding_status" />
        <result property="chunkCount"      column="chunk_count"      />
        <result property="createUser"      column="create_user"      />
        <result property="createTime"      column="create_time"      />
        <result property="updateTime"      column="update_time"      />
        <result property="deleted"         column="deleted"          />
    </resultMap>

</mapper>
